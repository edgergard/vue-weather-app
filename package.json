{
  "name": "vue-weather-app",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "vue-tsc -b",
    "lint": "eslint . --fix",
    "format": "prettier . --write",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.108.2",
    "@vueuse/core": "^13.9.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.46",
    "vue-router": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.12.1",
    "gh-pages": "^6.3.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.8",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.6",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.12"
  }
}
